.page-stats {
  min-height: 100vh;
  padding: 0 32rpx 40rpx;
}

/* 头部 */
.stats-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 36rpx 12rpx 28rpx;
}

.stats-total {
  font-size: 72rpx;
  font-weight: 800;
  color: #fff;
}

.stats-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 卡片 */
.chart-card {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.bar-canvas {
  width: 100%;
  height: 380rpx;
}

.pie-canvas {
  width: 100%;
  height: 360rpx;
}

/* 图例 */
.legend-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

.legend-name {
  font-size: 24rpx;
  color: #666;
}

.legend-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
}
