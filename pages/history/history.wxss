.page-history {
  min-height: 100vh;
  padding: 0 32rpx 40rpx;
}

/* 顶部统计 */
.stat-bar {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 36rpx 12rpx 28rpx;
}

.stat-num {
  font-size: 64rpx;
  font-weight: 800;
  color: #fff;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 时间线 */
.timeline {
  padding-top: 16rpx;
}

.day-group {
  margin-bottom: 36rpx;
}

.day-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.day-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.4);
}

.day-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.day-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: auto;
}

.day-items {
  padding-left: 28rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.15);
  margin-left: 7rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-left: 16rpx;
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-tag {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  background: linear-gradient(135deg, #667eea22, #764ba222);
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

.record-time {
  font-size: 24rpx;
  color: #aaa;
}

.record-remark {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 加载提示 */
.load-tip {
  text-align: center;
  padding: 40rpx 0;
  color: rgba(255, 255, 255, 0.35);
  font-size: 24rpx;
}
